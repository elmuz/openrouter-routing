# Managed by `openrouter-routing install-systemd`.
# Reinstall with --force to overwrite local edits.
[Unit]
Description=Refresh OpenRouter provider routing from recent pi sessions
Documentation=https://github.com/elmuz/openrouter-routing
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# OPENROUTER_MANAGEMENT_KEY for preset writes; absent file is not an error.
EnvironmentFile=-@ENV_FILE@
ExecStart=@EXEC_START@
StandardOutput=journal
StandardError=journal
